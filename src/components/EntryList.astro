---
export interface Row {
  href: string;
  /** 左侧小字：日期或条目 id */
  label?: string;
  title: string;
  /** 行内的类型/注记 */
  note?: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<ul class="post-list">
  {
    rows.map((row) => (
      <li>
        <a href={row.href}>
          <span class="d">{row.label}</span>
          {row.note && <span class="k">{row.note}</span>}
          <span class="t">{row.title}</span>
        </a>
      </li>
    ))
  }
</ul>
