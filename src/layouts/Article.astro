---
import Base from './Base.astro';
import type { ArticleMeta } from '../lib/index';

interface Props {
  meta: ArticleMeta;
  crumbs?: { href: string; label: string }[];
}

const { meta, crumbs = [] } = Astro.props;
---

<Base title={meta.title}>
  <article class="post">
    <header>
      {
        crumbs.length > 0 && (
          <p class="crumb">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && ' › '}
                <a href={c.href}>{c.label}</a>
              </>
            ))}
          </p>
        )
      }
      <h1>{meta.title}</h1>
      <p class="meta">
        <span>{meta.date}</span>
        {meta.updated && meta.updated !== meta.date && <span>修订 {meta.updated}</span>}
        {meta.dir === 'drafts' && <span class="tag">草稿</span>}
      </p>
    </header>

    <nav class="toc" aria-label="目录" hidden>
      <span class="label">目录</span>
      <ul></ul>
    </nav>

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<script>
  // 从正文里抽 h2/h3，生成左侧目录（不依赖 Markdown）
  const toc = document.querySelector<HTMLElement>('.post > .toc');
  const list = toc?.querySelector('ul');
  const prose = document.querySelector<HTMLElement>('.prose');

  if (toc && list && prose) {
    const heads = Array.from(prose.querySelectorAll<HTMLElement>('h2, h3'));

    if (heads.length >= 3) {
      for (const [i, h] of heads.entries()) {
        if (!h.id) h.id = `sec-${i + 1}`;
        const li = document.createElement('li');
        if (h.tagName === 'H3') li.className = 'd3';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent ?? '';
        li.appendChild(a);
        list.appendChild(li);
      }
      toc.hidden = false;
    }
  }
</script>
