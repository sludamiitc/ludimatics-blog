---
import Base from '../../layouts/Base.astro';
import { loadIndex, loadArticles, boardLists, orderedItems } from '../../lib/index';

const index = loadIndex();
const articles = loadArticles();
const lists = [...boardLists(index, 'list')].sort((a, b) => (a.id < b.id ? 1 : -1));
---

<Base title="LIST" description="按时间索引">
  <header class="board-head">
    <h1 class="board-title">LIST</h1>
    <p class="lede">按时间索引。从上到下，从新到旧；一年一组。</p>
  </header>

  {
    lists.map((list) => (
      <section class="tl-year">
        <h2 class="tl-year-title">
          <a href={`/list/${list.id}/`}>{list.title}</a>
        </h2>
        <ul class="tl">
          {orderedItems(list, 'list').map((item) => {
            const a = articles.get(item.article);
            if (!a) return null;
            return (
              <li>
                <a href={`/posts/${a.slug}/`}>
                  <span class="eid">{item.id}</span>
                  <span class="et">{a.title}</span>
                  <span class="em">{a.tags.slice(0, 2).join(' · ')}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Base>
