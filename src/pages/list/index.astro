---
import Base from '../../layouts/Base.astro';
import { loadIndex, loadArticles, resolveIndex, boardLists } from '../../lib/index';

const articles = loadArticles();
const lists = boardLists(resolveIndex(loadIndex(), articles), 'list');
---

<Base title="LIST">
  <header class="board-head">
    <h1 class="board-title">LIST</h1>
  </header>

  {
    lists.map((list) => (
      <section class="tl-year">
        <h2 class="tl-year-title">
          <a href={`/list/${list.id}/`}>{list.title}</a>
        </h2>
        <ul class="tl">
          {list.items.map((item) => {
            const a = articles.get(item.article);
            if (!a) return null;
            return (
              <li>
                <a href={`/posts/${a.slug}/`}>
                  <span class="eid">{item.id}</span>
                  <span class="et">{a.title}</span>
                  <span class="em">{a.tags.slice(0, 2).join(' · ')}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Base>
