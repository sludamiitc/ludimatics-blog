---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { loadIndex, loadArticles, resolveIndex, boardLists } from '../../lib/index';

export async function getStaticPaths() {
  const articles = loadArticles();
  const index = resolveIndex(loadIndex(), articles);
  return boardLists(index, 'list').map((list) => ({ params: { list: list.id }, props: { list } }));
}

const { list } = Astro.props;
const articles = loadArticles();

const rows = list.items
  .map((item) => {
    const a = articles.get(item.article);
    if (!a) return null;
    return { href: `/posts/${a.slug}/`, label: item.id, title: a.title, note: item.note };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);
---

<Base title={`${list.title} · LIST`}>
  <p class="crumb"><a href="/list/">LIST</a> › {list.title}</p>
  <h1 class="page-title">{list.title}</h1>

  {rows.length > 0 ? <EntryList rows={rows} /> : <p class="empty">这一年还没有文章。</p>}
</Base>
