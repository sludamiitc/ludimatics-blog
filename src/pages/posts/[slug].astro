---
import Article from '../../layouts/Article.astro';
import { registry } from '../../lib/articles.registry';
import { loadIndex, loadArticles, resolveIndex, listsContaining } from '../../lib/index';

export async function getStaticPaths() {
  // loadArticles() 在 dev 里含 drafts/，构建时只含 articles/
  const articles = loadArticles();
  return [...articles.values()].map((meta) => ({ params: { slug: meta.slug }, props: { meta } }));
}

const { meta } = Astro.props;

const where = listsContaining(resolveIndex(loadIndex(), loadArticles()), meta.slug);
const primary = where[0];

const crumbs = primary
  ? [
      { href: `/${primary.board}/`, label: primary.board.toUpperCase() },
      { href: `/${primary.board}/${primary.list.id}/`, label: primary.list.title },
      { href: `/posts/${meta.slug}/`, label: primary.entry.id },
    ]
  : [];

// 显式注册表：slug → 组件，由 tools/registry.mjs 生成（dev 含 drafts/，构建只含 articles/）
const loader = registry[meta.slug];

if (!loader) {
  throw new Error(
    `注册表里没有这篇文章：${meta.slug}。dev 下稍等热更新，或跑 pnpm check 重新生成注册表。`,
  );
}

const { default: Body } = (await loader()) as { default: any };
---

<Article meta={meta} crumbs={crumbs}>
  <Body />
</Article>
