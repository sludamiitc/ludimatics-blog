---
import Base from '../layouts/Base.astro';
import { loadIndex } from '../lib/index';

const { site } = loadIndex();
---

<Base title="ABOUT" description={site.description}>
  <header class="board-head">
    <h1 class="board-title">ABOUT</h1>
  </header>
  <article class="about">
    <p>
      一个正在修行的图形学学者，这里主要放一些我愿意公布的我在学习和工作方面的思考和想法。
      我觉得把一些琐碎的思考写下来总是没有错的。
    </p>
  </article>
</Base>
