---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { loadArticles, latestArticles } from '../../lib/index';

const articles = loadArticles();

const recent = latestArticles(articles, 4);
const rows = recent.map((a) => ({
  href: `/posts/${a.slug}/`,
  label: a.date,
  title: a.title,
}));
---

<Base title="SITE">
  <section class="intro">
    <p>
      由sludamiitc创立的简单的图形学及其计算机知识的网站，包含了我在图形学研究当中的各种见闻。
      同时也会分享我在当下的比较有意思的思考。无所不包，散乱无形。
    </p>
  </section>

  <p class="section-label">最近更新</p>
  <EntryList rows={rows} />
</Base>
