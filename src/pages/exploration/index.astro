---
import Base from '../../layouts/Base.astro';
import Block from '../../components/Block.astro';
import { loadIndex, loadArticles, boardLists, orderedItems } from '../../lib/index';

const index = loadIndex();
const articles = loadArticles();
const lists = boardLists(index, 'exploration');
---

<Base title="EXPLORATION" description="按项目索引">
  <header class="board-head">
    <h1 class="board-title">EXPLORATION</h1>
    <p class="lede">按项目索引。一个方块是一个项目，右边是它的状态。</p>
  </header>

  <div class="blk-grid">
    {
      lists.map((list) => (
        <Block
          title={list.title}
          href={`/exploration/${list.id}/`}
          meta={list.status}
          items={orderedItems(list, 'exploration').map((item) => {
            const a = articles.get(item.article);
            return a
              ? { href: `/posts/${a.slug}/`, text: a.title, mark: item.id }
              : null;
          }).filter((x): x is { href: string; text: string; mark: string } => x !== null)}
          moreHref={`/exploration/${list.id}/`}
          moreLabel={list.period ? `${list.period} · 项目页 →` : '项目页 →'}
        />
      ))
    }
  </div>
</Base>
